# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
lerna-debug.log*

# Next.js
.next/
out/
dist/
build/
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
/coverage
/.nyc_output

# Storybook
storybook-static/

# Parcel
.parcel-cache/

# Misc
.npm
.eslintcache
.stylelintcache
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# -----------------------------------------------------------------------------
