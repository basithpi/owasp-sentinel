*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
.secrets

# Environment files (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# Alembic
alembic/versions/*.pyc

# MinIO data
