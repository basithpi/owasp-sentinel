# ─────────────────────────────────────────────────────────────────────────────
# OWASP Sentinel v3 "Phantom Strike" — Environment Variables
# Copy this file to .env and fill in all values before starting services.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
DOMAIN=sentinel.example.com
ACME_EMAIL=security@example.com

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change_me_to_a_long_random_hex_string_at_least_64_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://sentinel.example.com","http://localhost:3000"]

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://sentinel:change_me_strong_password@postgres:5432/sentinel
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
REDIS_CACHE_TTL=3600

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:change_me_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_redis_password@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_SERIALIZER=json

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me_access_key
MINIO_SECRET_KEY=change_me_secret_key
MINIO_BUCKET=sentinel-reports
MINIO_SECURE=false

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://meilisearch:7700
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEILISEARCH_MASTER_KEY=change_me_meilisearch_master_key

# ── AI Providers (optional) ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── InteractSH ────────────────────────────────────────────────────────────────
INTERACTSH_SERVER_URL=https://interactsh.sentinel.example.com
INTERACTSH_DOMAIN=interactsh.sentinel.example.com
INTERACTSH_TOKEN=change_me_interactsh_token

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM=OWASP Sentinel <noreply@example.com>
SMTP_TLS=true

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_AI_TRIAGE=true
FEATURE_AUTO_RETEST=true
FEATURE_NUCLEI_SCAN=true
